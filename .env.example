# Server environment configuration. Keep credentials outside version control.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional explicit workspace. Otherwise the app tries one read-only Default lookup.
ANTHROPIC_WORKSPACE_ID=
# A long random token is required before paid Claude evaluations are enabled.
RISKGRAPH_ADMIN_TOKEN=
MAX_CLAUDE_CASES=200
SURREAL_MEMORY_URL=
SURREAL_MEMORY_CONTEXT=
SURREAL_MEMORY_API_KEY=
# Registered scope path in the Agent Memory Context.
SURREAL_MEMORY_SCOPE=org/riskgraph/demo
DATABASE_PATH=data/riskgraph.sqlite3
RISKGRAPH_BOOTSTRAP=true
